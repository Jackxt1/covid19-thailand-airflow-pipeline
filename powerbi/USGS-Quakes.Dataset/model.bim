{
  "name": "USGS-Quakes",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "th-TH",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "th-TH",
    "tables": [
      {
        "name": "fact_quakes",
        "columns": [
          {
            "name": "เดือน",
            "dataType": "dateTime",
            "formatString": "yyyy-mm-dd",
            "sourceColumn": "เดือน",
            "summarizeBy": "none",
            "annotations": [
              { "name": "SummarizationSetBy", "value": "Automatic" },
              { "name": "UnderlyingDateTimeDataType", "value": "Date" }
            ]
          },
          {
            "name": "ภูมิภาค",
            "dataType": "string",
            "sourceColumn": "ภูมิภาค",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "Automatic" } ]
          },
          {
            "name": "ช่วงขนาด",
            "dataType": "string",
            "sourceColumn": "ช่วงขนาด",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "Automatic" } ]
          },
          {
            "name": "ช่วงความลึก",
            "dataType": "string",
            "sourceColumn": "ช่วงความลึก",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "Automatic" } ]
          },
          {
            "name": "จำนวนเหตุการณ์",
            "dataType": "int64",
            "formatString": "#,0",
            "sourceColumn": "จำนวนเหตุการณ์",
            "summarizeBy": "sum",
            "annotations": [ { "name": "SummarizationSetBy", "value": "Automatic" } ]
          },
          {
            "name": "ขนาดเฉลี่ย",
            "dataType": "double",
            "formatString": "0.00",
            "sourceColumn": "ขนาดเฉลี่ย",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "User" } ]
          },
          {
            "name": "ขนาดสูงสุด",
            "dataType": "double",
            "formatString": "0.0",
            "sourceColumn": "ขนาดสูงสุด",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "User" } ]
          },
          {
            "name": "ความลึกเฉลี่ย",
            "dataType": "double",
            "formatString": "0.0",
            "sourceColumn": "ความลึกเฉลี่ย",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "User" } ]
          }
        ],
        "measures": [
          {
            "name": "เหตุการณ์ทั้งหมด",
            "expression": "SUM(fact_quakes[จำนวนเหตุการณ์])",
            "formatString": "#,0"
          },
          {
            "name": "ขนาดแรงที่สุด",
            "expression": "MAX(fact_quakes[ขนาดสูงสุด])",
            "formatString": "0.0"
          },
          {
            "name": "จำนวนภูมิภาค",
            "expression": "DISTINCTCOUNT(fact_quakes[ภูมิภาค])",
            "formatString": "#,0"
          },
          {
            "name": "เหตุการณ์ M6 ขึ้นไป",
            "expression": [
              "CALCULATE(",
              "    [เหตุการณ์ทั้งหมด],",
              "    fact_quakes[ช่วงขนาด] IN { \"6.0 - 6.9\", \"7.0 ขึ้นไป\" }",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "ความลึกเฉลี่ยถ่วงน้ำหนัก",
            "expression": [
              "-- แต่ละแถวเป็นค่าเฉลี่ยของกลุ่มอยู่แล้ว เอามาเฉลี่ยซ้ำตรง ๆ จะผิด",
              "-- ต้องถ่วงน้ำหนักด้วยจำนวนเหตุการณ์ของแถวนั้น",
              "VAR TotalDepth =",
              "    SUMX(",
              "        fact_quakes,",
              "        fact_quakes[ความลึกเฉลี่ย] * fact_quakes[จำนวนเหตุการณ์]",
              "    )",
              "RETURN",
              "    DIVIDE(TotalDepth, [เหตุการณ์ทั้งหมด])"
            ],
            "formatString": "0.0"
          },
          {
            "name": "สัดส่วน M6 ขึ้นไป",
            "expression": "DIVIDE([เหตุการณ์ M6 ขึ้นไป], [เหตุการณ์ทั้งหมด])",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "fact_quakes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\data1\\95-\\exports\\quakes\\fact_quakes.csv\"),[Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"เดือน\", type date}, {\"ภูมิภาค\", type text}, {\"ช่วงขนาด\", type text}, {\"ช่วงความลึก\", type text}, {\"จำนวนเหตุการณ์\", Int64.Type}, {\"ขนาดเฉลี่ย\", type number}, {\"ขนาดสูงสุด\", type number}, {\"ความลึกเฉลี่ย\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [ { "name": "PBI_ResultType", "value": "Table" } ]
      },
      {
