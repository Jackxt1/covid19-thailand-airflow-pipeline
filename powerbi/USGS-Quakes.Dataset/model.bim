            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\data1\\95-\\exports\\quakes\\dim_month.csv\"),[Delimiter=\",\", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"เดือน\", type date}, {\"ปี ค.ศ.\", Int64.Type}, {\"ปี พ.ศ.\", Int64.Type}, {\"เลขเดือน\", Int64.Type}, {\"เดือนไทย\", type text}, {\"ปีเดือน\", type text}, {\"ไตรมาส\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [ { "name": "PBI_ResultType", "value": "Table" } ]
      },
