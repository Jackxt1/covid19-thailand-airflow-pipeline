            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\data1\\95-\\exports\\dim_province.csv\"),[Delimiter=\",\", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"จังหวัด\", type text}, {\"ผู้ป่วยสะสม\", Int64.Type}, {\"อันดับ\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [ { "name": "PBI_ResultType", "value": "Table" } ]
      },
      {
        "name": "dim_age_group",
        "columns": [
          {
            "name": "ช่วงอายุ",
            "dataType": "string",
            "sourceColumn": "ช่วงอายุ",
            "sortByColumn": "ลำดับ",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "Automatic" } ]
          },
          {
            "name": "ลำดับ",
            "dataType": "int64",
            "formatString": "0",
            "sourceColumn": "ลำดับ",
            "summarizeBy": "none",
            "annotations": [ { "name": "SummarizationSetBy", "value": "User" } ]
          },
          {
            "name": "ผู้ป่วยสะสม",
            "dataType": "int64",
            "formatString": "#,0",
            "sourceColumn": "ผู้ป่วยสะสม",
            "summarizeBy": "sum",
            "annotations": [ { "name": "SummarizationSetBy", "value": "Automatic" } ]
          }
        ],
        "partitions": [
          {
            "name": "dim_age_group",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\data1\\95-\\exports\\dim_age_group.csv\"),[Delimiter=\",\", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"ช่วงอายุ\", type text}, {\"ลำดับ\", Int64.Type}, {\"ผู้ป่วยสะสม\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [ { "name": "PBI_ResultType", "value": "Table" } ]
      }
    ],
    "relationships": [
      {
        "name": "fact_to_dim_date",
        "fromTable": "fact_covid_cases",
        "fromColumn": "วันที่",
        "toTable": "dim_date",
        "toColumn": "วันที่"
      },
      {
        "name": "fact_to_dim_province",
        "fromTable": "fact_covid_cases",
        "fromColumn": "จังหวัด",
        "toTable": "dim_province",
        "toColumn": "จังหวัด"
      },
      {
        "name": "fact_to_dim_age_group",
