        "name": "PBI_QueryOrder",
        "value": "[\"fact_covid_cases\",\"dim_date\",\"dim_province\",\"dim_age_group\"]"
      },
      { "name": "__PBI_TimeIntelligenceEnabled", "value": "0" }
